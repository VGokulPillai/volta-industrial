{
  "name": "volta-industrial-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo \"Build artifacts are produced by scripts/build-app.sh\"",
    "build:source": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsdown --config tsdown.server.config.ts",
    "dev": "tsx watch --env-file-if-exists=.env server/server.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "submission2:export": "bash scripts/export-submission2.sh"
  },
  "dependencies": {
    "@databricks/appkit": "latest",
    "@databricks/appkit-ui": "latest",
    "@openai/agents": "latest",
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-orm": "latest",
    "express": "latest",
    "jsonc-parser": "latest",
    "leaflet": "latest",
    "lucide-react": "latest",
    "mlflow-tracing": "latest",
    "openai": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "react-markdown": "latest",
    "react-router": "latest",
    "recharts": "latest",
    "remark-gfm": "latest",
    "tailwindcss": "latest",
    "tailwindcss-animate": "latest",
    "tsdown": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "latest",
    "@types/express": "latest",
    "@types/leaflet": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
